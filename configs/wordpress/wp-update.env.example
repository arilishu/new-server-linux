# Copiar a la carpeta del sitio como wp-update.env (lo lee scripts/wp-update.sh).
SITE_HOST=example.com
DB_CONTAINER=SITIO-db
WP_CONTAINER=SITIO-wp
DB_NAME=SITIO
LOCAL_PORT=8086
EXCLUDE_THEMES=""
# ruta:texto que tiene que aparecer en la respuesta (sin texto = solo HTTP 200).
# Si el login está oculto (WPS Hide Login, Wordfence) usar otra página.
CHECKS="/ /wp-login.php:user_login"
WOOCOMMERCE=no
