# Configuración de los scripts de server-baseline. Copiar a
#   ~/.config/server-baseline/baseline.env   (chmod 600)
# Los scripts lo buscan ahí, o donde diga la variable BASELINE_ENV.

# Prefijo de los asuntos de mail ("[VPS] Falló ...").
SERVER_LABEL="VPS"

# Red
PUBLIC_IFACE="ens6"            # interfaz pública: `ip -br a`
SSH_PORT="2234"
TAILSCALE_IP="100.x.y.z"       # `tailscale ip -4`

# Avisos por mail (Resend). Archivo con RESEND_API_KEY, NOTIFY_FROM y NOTIFY_TO.
NOTIFY_ENV="$HOME/.config/notify/resend.env"

# Dónde dejan sus logs los scripts.
LOG_DIR="$HOME/backups"
AUDIT_DIR="$HOME/security-audits"

# Backups (scripts/backup.sh). Qué respaldar va en un archivo aparte (ver
# backup-targets.example.sh) porque son arrays de bash.
BACKUP_DIR="$HOME/backups/db"
BACKUP_TARGETS="$HOME/.config/server-baseline/backup-targets.sh"
S3_REMOTE=""                   # remote de rclone, p. ej. "awsbackup:mi-bucket/db-backups"; vacío = solo local
LOCAL_RETENTION_DAYS=7
S3_RETENTION_DAYS=30           # si el bucket tiene lifecycle propio, poner 0 (no borra desde acá)

# Proyectos Docker Compose que se actualizan los domingos (scripts/docker-update.sh).
# Los WordPress NO van acá: tienen su propio update diario (scripts/wp-update.sh).
DOCKER_PROJECTS="$HOME/n8n $HOME/postgres"

# Sitios que chequean post-reboot-check.sh y baseline-check.sh: "url:código_esperado".
SITES_CHECK="https://example.com:200 https://app.example.com/login:200"

# Reinicio automático cuando hay kernel nuevo (system-update.sh). "yes" o "no".
AUTO_REBOOT="yes"
